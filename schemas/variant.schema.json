{
  "$schema": "starsector-devtool/field-schema/v1",
  "id": "variant",
  "fileType": "variant",
  "displayName": "装配",
  "description": "Starsector .variant 装配文件",
  "sections": [
    {
      "id": "basic",
      "label": "基础",
      "fields": [
        {
          "key": "variantId",
          "type": "string",
          "label": "装配 ID",
          "required": true
        },
        {
          "key": "hullId",
          "type": "enum",
          "label": "船体 ID",
          "required": true,
          "source": "csv:ships.id"
        },
        {
          "key": "displayName",
          "type": "string",
          "label": "显示名称"
        },
        {
          "key": "goalVariant",
          "type": "boolean",
          "label": "默认可选装配"
        }
      ]
    },
    {
      "id": "flux",
      "label": "幅能",
      "fields": [
        {
          "key": "fluxVents",
          "type": "integer",
          "label": "幅能耗散管道",
          "min": 0
        },
        {
          "key": "fluxCapacitors",
          "type": "integer",
          "label": "幅能寄存器",
          "min": 0
        }
      ]
    },
    {
      "id": "mods",
      "label": "插件",
      "fields": [
        {
          "key": "hullMods",
          "type": "string-array",
          "label": "船体插件",
          "source": "csv:hullmods.id"
        },
        {
          "key": "permaMods",
          "type": "string-array",
          "label": "永久插件",
          "source": "csv:hullmods.id"
        },
        {
          "key": "sMods",
          "type": "string-array",
          "label": "S 插件",
          "source": "csv:hullmods.id"
        }
      ]
    },
    {
      "id": "weapons",
      "label": "武器组",
      "fields": [
        {
          "key": "weaponGroups",
          "type": "array-of-object",
          "label": "武器组",
          "nested": [
            {
              "key": "mode",
              "type": "enum",
              "label": "模式",
              "options": ["LINKED", "ALTERNATING", "LINKED_GROUP", "ALTERNATING_GROUP"]
            },
            {
              "key": "weapons",
              "type": "key-value",
              "label": "武器",
              "valueSchema": {
                "key": "weaponId",
                "type": "enum",
                "label": "武器 ID",
                "source": "csv:weapons.id"
              }
            },
            {
              "key": "autofire",
              "type": "boolean",
              "label": "自动开火"
            }
          ]
        }
      ]
    },
    {
      "id": "wings",
      "label": "联队",
      "fields": [
        {
          "key": "wings",
          "type": "array",
          "label": "联队",
          "item": {
            "key": "wingId",
            "type": "enum",
            "label": "联队 ID",
            "source": "csv:wings.id"
          }
        }
      ]
    },
    {
      "id": "modules",
      "label": "模块",
      "fields": [
        {
          "key": "modules",
          "type": "key-value",
          "format": "array-of-entries",
          "label": "模块",
          "valueSchema": {
            "key": "variantId",
            "type": "string",
            "label": "装配 ID"
          }
        }
      ]
    },
    {
      "id": "autofit",
      "label": "自动装配",
      "collapsed": true,
      "fields": [
        {
          "key": "quality",
          "type": "float",
          "label": "质量",
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "weaponQuality",
          "type": "float",
          "label": "武器质量",
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "fighterQuality",
          "type": "float",
          "label": "战机质量",
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        {
          "key": "doctrine",
          "type": "object",
          "label": "舰船学说",
          "nested": [
            {
              "key": "warships",
              "type": "integer",
              "label": "常规战舰"
            },
            {
              "key": "carriers",
              "type": "integer",
              "label": "航母"
            },
            {
              "key": "phaseShips",
              "type": "integer",
              "label": "相位战舰"
            },
            {
              "key": "officerQuality",
              "type": "integer",
              "label": "军官质量"
            }
          ]
        }
      ]
    }
  ]
}
