{
  "$schema": "starsector-devtool/field-schema/v1",
  "id": "faction",
  "fileType": ".faction",
  "displayName": "势力定义",
  "description": "Starsector 势力配置文件，定义势力的外观、舰队组成、教条、关系等",
  "sections": [
    {
      "id": "__all",
      "label": "势力定义",
      "fields": [
        {
          "key": "file.id",
          "type": "string",
          "label": "势力 ID",
          "description": "势力的唯一标识符，用于内部引用",
          "required": true,
          "editable": true,
          "danger": "修改 ID 会导致存档不兼容"
        },
        {
          "key": "file.displayName",
          "type": "string",
          "label": "显示名称",
          "description": "势力的短显示名称",
          "required": true,
          "editable": true
        },
        {
          "key": "file.displayNameWithArticle",
          "type": "string",
          "label": "带冠词的名称",
          "description": "带冠词的势力名称（英文为 the X，中文可与 displayName 相同）",
          "required": true,
          "editable": true
        },
        {
          "key": "file.displayNameLong",
          "type": "string",
          "label": "长名称",
          "description": "势力的完整长名称",
          "required": false,
          "editable": true
        },
        {
          "key": "file.displayNameLongWithArticle",
          "type": "string",
          "label": "带冠词的长名称",
          "description": "带冠词的势力完整名称",
          "required": false,
          "editable": true
        },
        {
          "key": "file.displayNameIsOrAre",
          "type": "string",
          "label": "Is/Are 后缀",
          "description": "英文语法中 is/are 的选择（中文留空即可）",
          "required": false,
          "editable": true,
          "default": ""
        },
        {
          "key": "file.personNamePrefixAOrAn",
          "type": "string",
          "label": "人名前缀冠词",
          "description": "人名前的不定冠词 a/an（中文留空即可）",
          "required": false,
          "editable": true,
          "default": ""
        },
        {
          "key": "file.entityNamePrefix",
          "type": "string",
          "label": "实体名称前缀",
          "description": "势力实体（如基地、站点）名称的前缀",
          "required": false,
          "editable": true
        },
        {
          "key": "file.personNamePrefix",
          "type": "string",
          "label": "人物名称前缀",
          "description": "势力人物名称的前缀修饰词",
          "required": false,
          "editable": true
        },
        {
          "key": "file.logo",
          "type": "path-image",
          "label": "势力标志",
          "description": "势力标志图片路径（相对于游戏/mod 根目录）",
          "required": true,
          "editable": true
        },
        {
          "key": "file.crest",
          "type": "path-image",
          "label": "势力徽章",
          "description": "势力徽章图片路径（用于 intel 等界面）",
          "required": true,
          "editable": true
        },
        {
          "key": "file.shipNamePrefix",
          "type": "string",
          "label": "舰船名前缀",
          "description": "势力舰船名称的前缀缩写（如 HSS, TTS）",
          "required": false,
          "editable": true,
          "default": ""
        },
        {
          "key": "file.color",
          "type": "color-rgba",
          "label": "主色调",
          "description": "势力主要颜色 [R, G, B, A]，范围 0-255",
          "required": true,
          "editable": true,
          "default": [255, 255, 255, 255],
          "min": 0,
          "max": 255
        },
        {
          "key": "file.baseUIColor",
          "type": "color-rgba",
          "label": "基础 UI 颜色",
          "description": "势力 UI 界面基础颜色 [R, G, B, A]",
          "required": false,
          "editable": true,
          "min": 0,
          "max": 255
        },
        {
          "key": "file.darkUIColor",
          "type": "color-rgba",
          "label": "深色 UI 颜色",
          "description": "势力 UI 界面深色 [R, G, B, A]",
          "required": false,
          "editable": true,
          "min": 0,
          "max": 255
        },
        {
          "key": "file.gridUIColor",
          "type": "color-rgba",
          "label": "网格 UI 颜色",
          "description": "势力 UI 网格线颜色 [R, G, B, A]",
          "required": false,
          "editable": true,
          "min": 0,
          "max": 255
        },
        {
          "key": "file.brightUIColor",
          "type": "color-rgba",
          "label": "亮色 UI 颜色",
          "description": "势力 UI 界面高亮颜色 [R, G, B, A]",
          "required": false,
          "editable": true,
          "min": 0,
          "max": 255
        },
        {
          "key": "file.shipNameSources",
          "type": "key-value",
          "label": "舰名来源",
          "description": "舰名生成器来源及其权重（如 ROMAN:2, GREEK:1）",
          "required": false,
          "editable": true,
          "default": {},
          "source": "enum:BRITISH_NAVY,ROMAN,GREEK,NORSE,EGYPTIAN,JAPANESE,CELTIC,AZTEC,SPACE,GENERAL,MERCANTILE,PIRATES,KNIGHTS,HEGEMONY"
        },
        {
          "key": "file.names",
          "type": "key-value",
          "label": "人名来源",
          "description": "人物姓名生成器来源及其权重",
          "required": false,
          "editable": true,
          "default": {},
          "source": "enum:modern,world,future,myth,old english,fringe,pirate"
        },
        {
          "key": "file.variantOverrides",
          "type": "key-value",
          "label": "装配覆盖",
          "description": "限制特定船体使用指定装配并调整其出现概率",
          "required": false,
          "editable": true,
          "default": {}
        },
        {
          "key": "file.hullFrequency",
          "type": "object",
          "label": "船体出现频率",
          "description": "船体在势力舰队中出现的频率乘数",
          "required": false,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "key-value",
              "label": "标签频率",
              "description": "按标签设置频率乘数",
              "required": false,
              "editable": true,
              "default": {},
              "source": "csv:ships.tags"
            },
            {
              "key": "hulls",
              "type": "key-value",
              "label": "船体频率",
              "description": "按具体船体 ID 设置频率乘数",
              "required": false,
              "editable": true,
              "default": {},
              "source": "csv:ships.id"
            }
          ]
        },
        {
          "key": "file.shipsWhenImporting",
          "type": "object",
          "label": "进口时可用舰船",
          "description": "势力在从其他势力进口蓝图时可额外获得的舰船",
          "required": false,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "string-array",
              "label": "标签",
              "description": "进口时包含的蓝图标签",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:ships.tags"
            },
            {
              "key": "hulls",
              "type": "string-array",
              "label": "船体列表",
              "description": "进口时包含的具体船体 ID",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:ships.id"
            }
          ]
        },
        {
          "key": "file.knownShips",
          "type": "object",
          "label": "已知舰船",
          "description": "势力已知（可生产/使用）的舰船蓝图",
          "required": true,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "string-array",
              "label": "蓝图标签",
              "description": "包含这些标签的船体蓝图将被势力获知",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:ships.tags"
            },
            {
              "key": "hulls",
              "type": "string-array",
              "label": "船体列表",
              "description": "势力已知的具体船体 ID 列表",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:ships.id"
            }
          ]
        },
        {
          "key": "file.priorityShips",
          "type": "object",
          "label": "优先舰船",
          "description": "势力优先使用的舰船（即使有其他可用船体也倾向使用这些）",
          "required": false,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "string-array",
              "label": "标签",
              "description": "优先使用这些标签的船体",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:ships.tags"
            },
            {
              "key": "hulls",
              "type": "string-array",
              "label": "船体列表",
              "description": "优先使用的具体船体 ID",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:ships.id"
            }
          ]
        },
        {
          "key": "file.knownFighters",
          "type": "object",
          "label": "已知战机",
          "description": "势力已知（可生产/使用）的战机联队蓝图",
          "required": true,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "string-array",
              "label": "蓝图标签",
              "description": "包含这些标签的战机蓝图将被势力获知",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:wings.tags"
            },
            {
              "key": "fighters",
              "type": "string-array",
              "label": "战机列表",
              "description": "势力已知的具体战机联队 ID",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:wings.id"
            }
          ]
        },
        {
          "key": "file.priorityFighters",
          "type": "object",
          "label": "优先战机",
          "description": "势力优先使用的战机联队",
          "required": false,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "string-array",
              "label": "标签",
              "description": "优先使用这些标签的战机",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:wings.tags"
            },
            {
              "key": "fighters",
              "type": "string-array",
              "label": "战机列表",
              "description": "优先使用的具体战机联队 ID",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:wings.id"
            }
          ]
        },
        {
          "key": "file.knownWeapons",
          "type": "object",
          "label": "已知武器",
          "description": "势力已知（可生产/使用）的武器蓝图",
          "required": true,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "string-array",
              "label": "蓝图标签",
              "description": "包含这些标签的武器蓝图将被势力获知",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:weapons.tags"
            },
            {
              "key": "weapons",
              "type": "string-array",
              "label": "武器列表",
              "description": "势力已知的具体武器 ID",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:weapons.id"
            }
          ]
        },
        {
          "key": "file.priorityWeapons",
          "type": "object",
          "label": "优先武器",
          "description": "势力优先使用的武器",
          "required": false,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "string-array",
              "label": "标签",
              "description": "优先使用这些标签的武器",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:weapons.tags"
            },
            {
              "key": "weapons",
              "type": "string-array",
              "label": "武器列表",
              "description": "优先使用的具体武器 ID",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:weapons.id"
            }
          ]
        },
        {
          "key": "file.knownHullMods",
          "type": "object",
          "label": "已知舰船插件",
          "description": "势力已知（可使用）的舰船插件蓝图",
          "required": false,
          "editable": true,
          "nested": [
            {
              "key": "tags",
              "type": "string-array",
              "label": "蓝图标签",
              "description": "包含这些标签的舰船插件将被势力获知",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:hullmods.tags"
            },
            {
              "key": "hullMods",
              "type": "string-array",
              "label": "舰船插件列表",
              "description": "势力已知的具体舰船插件 ID",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:hullmods.id"
            }
          ]
        },
        {
          "key": "file.weaponSellFrequency",
          "type": "key-value",
          "label": "武器出售频率",
          "description": "势力市场上各武器的出售频率权重",
          "required": false,
          "editable": true,
          "default": {},
          "source": "csv:weapons.id"
        },
        {
          "key": "file.fighterSellFrequency",
          "type": "key-value",
          "label": "战机出售频率",
          "description": "势力市场上各战机联队的出售频率权重",
          "required": false,
          "editable": true,
          "default": {},
          "source": "csv:wings.id"
        },
        {
          "key": "file.hullmodSellFrequency",
          "type": "key-value",
          "label": "舰船插件出售频率",
          "description": "势力市场上各舰船插件的出售频率权重",
          "required": false,
          "editable": true,
          "default": {},
          "source": "csv:hullmods.id"
        },
        {
          "key": "file.factionDoctrine",
          "type": "object",
          "label": "舰队教条",
          "description": "势力舰队生成的教条参数，决定舰队组成偏好",
          "required": true,
          "editable": true,
          "nested": [
            {
              "key": "warships",
              "type": "integer",
              "label": "常规战舰权重",
              "description": "舰队中常规战舰的配比权重",
              "required": true,
              "editable": true,
              "default": 5,
              "min": 0,
              "max": 7
            },
            {
              "key": "carriers",
              "type": "integer",
              "label": "航母权重",
              "description": "舰队中航母的配比权重",
              "required": true,
              "editable": true,
              "default": 2,
              "min": 0,
              "max": 7
            },
            {
              "key": "phaseShips",
              "type": "integer",
              "label": "相位舰权重",
              "description": "舰队中相位舰的配比权重",
              "required": true,
              "editable": true,
              "default": 0,
              "min": 0,
              "max": 7
            },
            {
              "key": "officerQuality",
              "type": "integer",
              "label": "军官质量",
              "description": "军官技能等级和数量的质量系数（1-5）",
              "required": true,
              "editable": true,
              "default": 3,
              "min": 1,
              "max": 5
            },
            {
              "key": "shipQuality",
              "type": "integer",
              "label": "舰船质量",
              "description": "舰船 D-mod 出现概率的反向系数（越高越少 D-mod）",
              "required": true,
              "editable": true,
              "default": 3,
              "min": 1,
              "max": 5
            },
            {
              "key": "numShips",
              "type": "integer",
              "label": "舰船数量",
              "description": "舰队规模倾向（越高舰队越大）",
              "required": true,
              "editable": true,
              "default": 3,
              "min": 1,
              "max": 5
            },
            {
              "key": "shipSize",
              "type": "integer",
              "label": "舰船体型",
              "description": "舰队中大型舰船的倾向性（越高越多大船）",
              "required": true,
              "editable": true,
              "default": 3,
              "min": 1,
              "max": 5
            },
            {
              "key": "aggression",
              "type": "integer",
              "label": "攻击性",
              "description": "AI 军官默认攻击性倾向（1=谨慎更多, 5=鲁莽更多）",
              "required": true,
              "editable": true,
              "default": 3,
              "min": 1,
              "max": 5
            },
            {
              "key": "combatFreighterProbability",
              "type": "float",
              "label": "战斗货船概率",
              "description": "舰队中货船替换为战斗货船的概率（0-1）",
              "required": false,
              "editable": true,
              "default": 0,
              "min": 0,
              "max": 1
            },
            {
              "key": "combatFreighterCombatUseFraction",
              "type": "float",
              "label": "战斗货船参战比例",
              "description": "战斗货船作为常规战斗编组的比例",
              "required": false,
              "editable": true,
              "default": 0,
              "min": 0,
              "max": 1
            },
            {
              "key": "combatFreighterCombatUseFractionWhenPriority",
              "type": "float",
              "label": "优先战斗货船参战比例",
              "description": "当标记为优先舰船时战斗货船参战的比例",
              "required": false,
              "editable": true,
              "default": 0,
              "min": 0,
              "max": 1
            },
            {
              "key": "autofitRandomizeProbability",
              "type": "float",
              "label": "自动装配随机化概率",
              "description": "舰船自动装配时偏离最佳配置的概率",
              "required": false,
              "editable": true,
              "default": 0.1,
              "min": 0,
              "max": 1
            },
            {
              "key": "officerSkillsShuffleProbability",
              "type": "float",
              "label": "军官技能随机化概率",
              "description": "军官从 officerSkills 列表以外选择技能的概率",
              "required": false,
              "editable": true,
              "default": 1,
              "min": 0,
              "max": 1
            },
            {
              "key": "officerSkills",
              "type": "string-array",
              "label": "军官偏好技能",
              "description": "军官优先选择的技能 ID 列表",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:skills.id"
            },
            {
              "key": "commanderSkillsShuffleProbability",
              "type": "float",
              "label": "指挥官技能随机化概率",
              "description": "指挥官从 commanderSkills 列表以外选择技能的概率",
              "required": false,
              "editable": true,
              "default": 1,
              "min": 0,
              "max": 1
            },
            {
              "key": "commanderSkills",
              "type": "string-array",
              "label": "指挥官偏好技能",
              "description": "指挥官优先选择的技能 ID 列表",
              "required": false,
              "editable": true,
              "default": [],
              "source": "csv:skills.id"
            }
          ]
        },
        {
          "key": "file.shipRoles",
          "type": "key-value",
          "label": "舰船角色分配",
          "description": "按角色分类的舰船装配权重配置。每个角色（如 combatSmall, combatLarge）的值是一个对象，包含 includeDefault (boolean) 和若干 装配ID: 权重(number) 的键值对",
          "required": false,
          "editable": true,
          "default": {}
        },
        {
          "key": "file.illegalCommodities",
          "type": "string-array",
          "label": "违禁品",
          "description": "在该势力领地内属于违禁品的商品 ID 列表",
          "required": false,
          "editable": true,
          "default": [],
          "source": "csv:commodities.id"
        },
        {
          "key": "file.music",
          "type": "object",
          "label": "音乐配置",
          "description": "势力在各场景下播放的音乐 ID",
          "required": false,
          "editable": true,
          "nested": [
            {
              "key": "theme",
              "type": "string",
              "label": "主题音乐",
              "description": "势力默认主题音乐",
              "required": false,
              "editable": true
            },
            {
              "key": "market_neutral",
              "type": "string",
              "label": "中立市场音乐",
              "description": "与势力关系中立时的市场音乐",
              "required": false,
              "editable": true
            },
            {
              "key": "market_hostile",
              "type": "string",
              "label": "敌对市场音乐",
              "description": "与势力关系敌对时的市场音乐",
              "required": false,
              "editable": true
            },
            {
              "key": "market_friendly",
              "type": "string",
