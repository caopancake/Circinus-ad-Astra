{
  "$schema": "starsector-devtool/csv-columns/v1",
  "table": "ships",
  "columns": [
    { "key": "name", "label": "名称", "control": "text" },
    { "key": "id", "label": "ID", "control": "text" },
    { "key": "designation", "label": "定位", "control": "text" },
    { "key": "tech/manufacturer", "label": "设计类型", "control": "text" },
    { "key": "system id", "label": "战术系统", "control": "reference", "source": "csv:shipSystems.id" },
    { "key": "fleet pts", "label": "舰队点", "control": "number", "step": 1 },
    { "key": "hitpoints", "label": "结构", "control": "number", "step": 1 },
    { "key": "armor rating", "label": "装甲", "control": "number", "step": 1 },
    { "key": "max flux", "label": "幅能容量", "control": "number", "step": 1 },
    { "key": "8/6/5/4%", "label": "8/6/5/4%", "control": "text" },
    { "key": "flux dissipation", "label": "幅能耗散", "control": "number", "step": 1 },
    { "key": "ordnance points", "label": "装配点", "control": "number", "step": 1 },
    { "key": "fighter bays", "label": "甲板数量", "control": "number", "step": 1 },
    { "key": "max speed", "label": "战斗内速度", "control": "number", "step": 1 },
    { "key": "acceleration", "label": "加速度", "control": "number", "step": 1 },
    { "key": "deceleration", "label": "减速度", "control": "number", "step": 1 },
    { "key": "max turn rate", "label": "最大转向", "control": "number", "step": 1 },
    { "key": "turn acceleration", "label": "转向加速", "control": "number", "step": 1 },
    { "key": "mass", "label": "质量", "control": "number", "step": 1 },
    { "key": "shield type", "label": "护盾类型", "control": "enum", "options": ["NONE", "FRONT", "OMNI", "PHASE"] },
    { "key": "defense id", "label": "防御系统", "control": "text" },
    { "key": "shield arc", "label": "护盾角度", "control": "number", "step": 1 },
    { "key": "shield upkeep", "label": "护盾维持", "control": "number", "step": 0.01 },
    { "key": "shield efficiency", "label": "护盾效率", "control": "number", "step": 0.1 },
    { "key": "phase cost", "label": "相位消耗", "control": "number", "step": 0.01 },
    { "key": "phase upkeep", "label": "相位维持", "control": "number", "step": 0.01 },
    { "key": "min crew", "label": "最少船员", "control": "number", "step": 1 },
    { "key": "max crew", "label": "最多船员", "control": "number", "step": 1 },
    { "key": "cargo", "label": "货仓", "control": "number", "step": 1 },
    { "key": "fuel", "label": "燃料", "control": "number", "step": 1 },
    { "key": "fuel/ly", "label": "燃料/光年", "control": "number", "step": 0.1 },
    { "key": "range", "label": "航程", "control": "number", "step": 1 },
    { "key": "max burn", "label": "最大航速", "control": "number", "step": 1 },
    { "key": "base value", "label": "基础价值", "control": "number", "step": 1 },
    { "key": "cr %/day", "label": "战备恢复/天", "control": "number", "step": 0.01 },
    { "key": "CR to deploy", "label": "部署战备", "control": "number", "step": 0.01 },
    { "key": "peak CR sec", "label": "峰值时间", "control": "number", "step": 1 },
    { "key": "CR loss/sec", "label": "战备损耗/秒", "control": "number", "step": 0.01 },
    { "key": "supplies/rec", "label": "维修补给", "control": "number", "step": 1 },
    { "key": "supplies/mo", "label": "月维持补给", "control": "number", "step": 1 },
    { "key": "c/s", "label": "货舱/补给消耗", "control": "number", "step": 1 },
    { "key": "c/f", "label": "货舱/燃料消耗", "control": "number", "step": 1 },
    { "key": "f/s", "label": "燃料/补给消耗", "control": "number", "step": 1 },
    { "key": "f/f", "label": "燃料/燃料消耗", "control": "number", "step": 1 },
    { "key": "crew/s", "label": "船员/补给消耗", "control": "number", "step": 1 },
    { "key": "crew/f", "label": "船员/燃料消耗", "control": "number", "step": 1 },
    { "key": "hints", "label": "Hints 标记", "control": "tags", "source": "csv:ships.hints" },
    { "key": "tags", "label": "Tags 标签", "control": "tags", "source": "csv:ships.tags" },
    { "key": "logistics n/a reason", "label": "后勤不适用原因", "control": "text" },
    { "key": "codex variant id", "label": "百科装配", "control": "text" },
    { "key": "rarity", "label": "稀有度", "control": "number", "step": 0.01 },
    { "key": "breakProb", "label": "损坏概率", "control": "number", "step": 0.01 },
    { "key": "minPieces", "label": "最少碎片", "control": "number", "step": 1 },
    { "key": "maxPieces", "label": "最多碎片", "control": "number", "step": 1 },
    { "key": "travel drive", "label": "旅行引擎", "control": "text" },
    { "key": "number", "label": "编号", "control": "number", "step": 1 }
  ]
}
