{
  "$schema": "starsector-devtool/csv-columns/v1",
  "table": "shipSystems",
  "columns": [
    { "key": "name", "label": "名称", "control": "text" },
    { "key": "id", "label": "ID", "control": "text" },
    { "key": "flux/second", "label": "幅能/秒", "control": "number", "step": 0.1 },
    { "key": "f/s (base rate)", "label": "基础幅能/秒倍率", "control": "number", "step": 0.1 },
    { "key": "f/s (base cap)", "label": "基础幅能/秒上限", "control": "number", "step": 0.1 },
    { "key": "flux/use", "label": "每次幅能", "control": "number", "step": 0.1 },
    { "key": "f/u (base rate)", "label": "基础每次幅能倍率", "control": "number", "step": 0.1 },
    { "key": "f/u (base cap)", "label": "基础每次幅能上限", "control": "number", "step": 0.1 },
    { "key": "cr/u", "label": "每次 CR", "control": "number", "step": 0.1 },
    { "key": "max uses", "label": "最大次数", "control": "number", "step": 1 },
    { "key": "regen", "label": "恢复", "control": "number", "step": 0.1 },
    { "key": "charge up", "label": "渐入", "control": "number", "step": 0.1 },
    { "key": "active", "label": "持续", "control": "number", "step": 0.1 },
    { "key": "down", "label": "渐出", "control": "number", "step": 0.1 },
    { "key": "cooldown", "label": "冷却", "control": "number", "step": 0.1 },
    { "key": "toggle", "label": "切换", "control": "boolean" },
    { "key": "noDissipation", "label": "禁止耗散", "control": "boolean" },
    { "key": "noHardDissipation", "label": "禁止硬幅能耗散", "control": "boolean" },
    { "key": "hardFlux", "label": "产生硬幅能", "control": "boolean" },
    { "key": "noFiring", "label": "禁止开火", "control": "boolean" },
    { "key": "noTurning", "label": "禁止转向", "control": "boolean" },
    { "key": "noStrafing", "label": "禁止横移", "control": "boolean" },
    { "key": "noAccel", "label": "禁止加速", "control": "boolean" },
    { "key": "noShield", "label": "禁止护盾", "control": "boolean" },
    { "key": "noVent", "label": "禁止强制排散", "control": "boolean" },
    { "key": "isPhaseCloak", "label": "视作相位", "control": "boolean" },
    { "key": "tags", "label": "Tags 标签", "control": "tags", "source": "csv:shipSystems.tags" },
    { "key": "icon", "label": "图标", "control": "path-image" }
  ]
}
