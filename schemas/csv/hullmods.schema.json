{
  "$schema": "starsector-devtool/csv-columns/v1",
  "table": "hullmods",
  "columns": [
    { "key": "name", "label": "名称", "control": "text" },
    { "key": "id", "label": "ID", "control": "text" },
    { "key": "tier", "label": "等级", "control": "number", "step": 1 },
    { "key": "rarity", "label": "稀有度", "control": "number", "step": 0.01 },
    { "key": "tech/manufacturer", "label": "设计类型", "control": "text" },
    { "key": "tags", "label": "Tags 标签", "control": "tags", "source": "csv:hullmods.tags" },
    { "key": "uiTags", "label": "UI 标签", "control": "tags", "source": "csv:hullmods.uiTags" },
    { "key": "base value", "label": "基础价值", "control": "number", "step": 1 },
    { "key": "unlocked", "label": "已解锁", "control": "boolean" },
    { "key": "hidden", "label": "隐藏", "control": "boolean" },
    { "key": "hiddenEverywhere", "label": "完全隐藏", "control": "boolean" },
    { "key": "cost_frigate", "label": "护卫舰 OP", "control": "number", "step": 1 },
    { "key": "cost_dest", "label": "驱逐舰 OP", "control": "number", "step": 1 },
    { "key": "cost_cruiser", "label": "巡洋舰 OP", "control": "number", "step": 1 },
    { "key": "cost_capital", "label": "主力舰 OP", "control": "number", "step": 1 },
    { "key": "script", "label": "脚本", "control": "text" },
    { "key": "desc", "label": "描述", "control": "text" },
    { "key": "short", "label": "短描述", "control": "text" },
    { "key": "sModDesc", "label": "内置描述", "control": "text" },
    { "key": "sprite", "label": "图标", "control": "path-image" }
  ]
}
