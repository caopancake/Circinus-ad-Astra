{
  "$schema": "circinus-ad-astra/csv-columns/v1",
  "table": "industries",
  "columns": [
    { "key": "id", "label": "ID", "control": "text" },
    { "key": "name", "label": "名称", "control": "text" },
    { "key": "cost mult", "label": "成本倍数", "control": "number", "step": 0.1 },
    { "key": "build time", "label": "建造时间", "control": "number", "step": 1 },
    { "key": "income", "label": "收入", "control": "number", "step": 1 },
    { "key": "upkeep", "label": "维护费", "control": "number", "step": 1 },
    { "key": "downgrade", "label": "降级为", "control": "text" },
    { "key": "upgrade", "label": "升级为", "control": "text" },
    { "key": "tags", "label": "Tags 标签", "control": "tags", "source": "csv:industries.tags" },
    { "key": "data", "label": "数据", "control": "text" },
    { "key": "image", "label": "图标", "control": "path-image" },
    { "key": "plugin", "label": "插件", "control": "text" },
    { "key": "desc", "label": "描述", "control": "text" },
    { "key": "order", "label": "排序", "control": "number", "step": 1 },
    { "key": "disruptDanger", "label": "破坏危险度", "control": "number", "step": 0.1 }
  ]
}
