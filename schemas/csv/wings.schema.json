{
  "$schema": "circinus-ad-astra/csv-columns/v1",
  "table": "wings",
  "columns": [
    { "key": "id", "label": "ID", "control": "text" },
    { "key": "variant", "label": "装配", "control": "reference", "source": "csv:variants.variantId" },
    { "key": "tags", "label": "Tags 标签", "control": "tags", "source": "csv:wings.tags" },
    { "key": "tier", "label": "级别", "control": "number", "step": 1 },
    { "key": "rarity", "label": "稀有度", "control": "number", "step": 0.01 },
    { "key": "fleet pts", "label": "舰队点", "control": "number", "step": 1 },
    { "key": "op cost", "label": "装配点", "control": "number", "step": 1 },
    { "key": "formation", "label": "阵型", "control": "enum", "options": ["CLAW", "V", "BOX", "DIAMOND"] },
    { "key": "range", "label": "作战范围", "control": "number", "step": 1 },
    { "key": "attackRunRange", "label": "攻击距离", "control": "number", "step": 1 },
    { "key": "attackPositionOffset", "label": "攻击位置偏移", "control": "number", "step": 1 },
    { "key": "num", "label": "数量", "control": "number", "step": 1 },
    { "key": "role", "label": "角色", "control": "enum", "options": ["FIGHTER", "INTERCEPTOR", "BOMBER", "ASSAULT", "SUPPORT"] },
    { "key": "role desc", "label": "角色描述", "control": "text" },
    { "key": "refit", "label": "整备时间", "control": "number", "step": 0.1 },
    { "key": "base value", "label": "基础价值", "control": "number", "step": 1 },
    { "key": "number", "label": "编号", "control": "number", "step": 1 }
  ]
}
