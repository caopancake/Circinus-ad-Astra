{
  "$schema": "starsector-devtool/csv-columns/v1",
  "table": "abilities",
  "columns": [
    { "key": "name", "label": "名称", "control": "text" },
    { "key": "id", "label": "ID", "control": "text" },
    { "key": "type", "label": "类型", "control": "enum", "options": ["campaign", "combat"] },
    { "key": "tags", "label": "Tags 标签", "control": "tags", "source": "csv:abilities.tags" },
    { "key": "activationDays", "label": "激活天数", "control": "number", "step": 0.1 },
    { "key": "activationCooldown", "label": "激活冷却", "control": "number", "step": 0.1 },
    { "key": "durationDays", "label": "持续天数", "control": "number", "step": 0.1 },
    { "key": "deactivationDays", "label": "停用天数", "control": "number", "step": 0.1 },
    { "key": "deactivationCooldown", "label": "停用冷却", "control": "number", "step": 0.1 },
    { "key": "unlockedAtStart", "label": "初始解锁", "control": "boolean" },
    { "key": "defaultForAIFleet", "label": "AI 默认", "control": "boolean" },
    { "key": "musicSuppression", "label": "音乐抑制", "control": "number", "step": 0.1 },
    { "key": "uiOn", "label": "UI 开启音", "control": "text" },
    { "key": "uiOff", "label": "UI 关闭音", "control": "text" },
    { "key": "uiLoop", "label": "UI 循环音", "control": "text" },
    { "key": "worldOn", "label": "世界开启音", "control": "text" },
    { "key": "worldOff", "label": "世界关闭音", "control": "text" },
    { "key": "worldLoop", "label": "世界循环音", "control": "text" },
    { "key": "icon", "label": "图标", "control": "path-image" },
    { "key": "plugin", "label": "插件", "control": "text" },
    { "key": "ai", "label": "AI 脚本", "control": "text" },
    { "key": "desc", "label": "描述", "control": "text" },
    { "key": "sortOrder", "label": "排序", "control": "number", "step": 1 }
  ]
}
