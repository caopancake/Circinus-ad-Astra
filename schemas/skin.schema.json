{
  "$schema": "starsector-devtool/field-schema/v1",
  "id": "skin",
  "fileType": "skin",
  "displayName": "舰船皮肤",
  "description": "Starsector .skin 舰船皮肤文件",
  "sections": [
    {
      "id": "basic",
      "label": "基础",
      "fields": [
        {
          "key": "skinHullId",
          "type": "string",
          "label": "皮肤的船体 ID",
          "required": true
        },
        {
          "key": "baseHullId",
          "type": "enum",
          "label": "基础船体 ID",
          "required": true,
          "source": "csv:ships.id"
        },
        {
          "key": "hullName",
          "type": "string",
          "label": "船体名称"
        },
        {
          "key": "hullDesignation",
          "type": "string",
          "label": "定位"
        },
        {
          "key": "descriptionId",
          "type": "enum",
          "label": "覆盖描述 ID",
          "source": "csv:descriptions.id"
        },
        {
          "key": "descriptionPrefix",
          "type": "string",
          "label": "描述前缀"
        },
        {
          "key": "tech",
          "type": "string",
          "label": "科技"
        },
        {
          "key": "spriteName",
          "type": "path-image",
          "label": "贴图路径"
        }
      ]
    },
    {
      "id": "flags",
      "label": "标签与规则",
      "fields": [
        {
          "key": "tags",
          "type": "tag-select",
          "label": "标签",
          "source": "csv:ships.tags"
        },
        {
          "key": "removeHints",
          "type": "string-array",
          "label": "移除 Hints 标记"
        },
        {
          "key": "addHints",
          "type": "string-array",
          "label": "添加 Hints 标记"
        },
        {
          "key": "restoreToBaseHull",
          "type": "boolean",
          "label": "可恢复为基础船体"
        },
        {
          "key": "incompatibleWithBaseHull",
          "type": "boolean",
          "label": "与基础船体不兼容"
        }
      ]
    },
    {
      "id": "stats",
      "label": "数值覆盖",
      "fields": [
        {
          "key": "fleetPoints",
          "type": "integer",
          "label": "舰队点数",
          "min": 0
        },
        {
          "key": "ordnancePoints",
          "type": "integer",
          "label": "装配点数",
          "min": 0
        },
        {
          "key": "baseValueMult",
          "type": "float",
          "label": "基础价值倍数",
          "min": 0,
          "step": 0.05
        },
        {
          "key": "suppliesToRecover",
          "type": "integer",
          "label": "维修补给",
          "min": 0
        },
        {
          "key": "suppliesPerMonth",
          "type": "integer",
          "label": "月维持补给",
          "min": 0
        },
        {
          "key": "fighterBays",
          "type": "integer",
          "label": "甲板数量",
          "min": 0
        },
        {
          "key": "maxSpeed",
          "type": "integer",
          "label": "战斗内速度"
        },
        {
          "key": "shieldEfficiency",
          "type": "float",
          "label": "护盾效率",
          "min": 0,
          "step": 0.05
        }
      ]
    },
    {
      "id": "mods",
      "label": "插件",
      "fields": [
        {
          "key": "builtInMods",
          "type": "string-array",
          "label": "内置插件",
          "source": "csv:hullmods.id"
        },
        {
          "key": "removeBuiltInMods",
          "type": "string-array",
          "label": "移除内置插件",
          "source": "csv:hullmods.id"
        }
      ]
    },
    {
      "id": "weapons",
      "label": "武器",
      "fields": [
        {
          "key": "builtInWeapons",
          "type": "key-value",
          "label": "内置武器",
          "valueSchema": {
            "key": "weaponId",
            "type": "enum",
            "label": "weapon",
            "source": "csv:weapons.id"
          }
        },
        {
          "key": "removeBuiltInWeapons",
          "type": "string-array",
          "label": "移除内置武器",
          "source": "csv:weapons.id"
        },
        {
          "key": "removeWeaponSlots",
          "type": "string-array",
          "label": "移除武器槽"
        },
        {
          "key": "weaponSlotChanges",
          "type": "key-value",
          "label": "改变武器槽",
          "valueSchema": {
            "key": "slot",
            "type": "object",
            "label": "slot",
            "nested": [
              {
                "key": "type",
                "type": "enum",
                "label": "类型",
                "options": [
                  "BALLISTIC",
                  "ENERGY",
                  "MISSILE",
                  "HYBRID",
                  "UNIVERSAL",
                  "SYNERGY",
                  "COMPOSITE",
                  "DECORATIVE",
                  "SYSTEM",
                  "STATION_MODULE",
                  "LAUNCH_BAY"
                ]
              },
              {
                "key": "size",
                "type": "enum",
                "label": "大小",
                "options": ["SMALL", "MEDIUM", "LARGE"]
              },
              {
                "key": "mount",
                "type": "enum",
                "label": "安装方式",
                "options": ["TURRET", "HARDPOINT", "HIDDEN"]
              },
              {
                "key": "angle",
                "type": "float",
                "label": "角度"
              },
              {
                "key": "arc",
                "type": "float",
                "label": "射角"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "wings",
      "label": "联队",
      "fields": [
        {
          "key": "builtInWings",
          "type": "array",
          "label": "内置联队",
          "item": {
            "key": "wingId",
            "type": "enum",
            "label": "wing",
            "source": "csv:wings.id"
          }
        }
      ]
    },
    {
      "id": "system",
      "label": "战术系统与视觉",
      "fields": [
        {
          "key": "systemId",
          "type": "enum",
          "label": "战术系统 ID",
          "source": "csv:shipSystems.id"
        },
        {
          "key": "coversColor",
          "type": "color-rgba",
          "label": "武器盖板颜色"
        }
      ]
    },
    {
      "id": "engines",
      "label": "引擎槽",
      "fields": [
        {
          "key": "removeEngineSlots",
          "type": "string-array",
          "label": "移除引擎槽"
        },
        {
          "key": "engineSlotChanges",
          "type": "key-value",
          "label": "改变引擎槽",
          "valueSchema": {
            "key": "engine",
            "type": "object",
            "label": "engine",
            "nested": [
              {
                "key": "style",
                "type": "string",
                "label": "风格"
              },
              {
                "key": "length",
                "type": "float",
                "label": "长度"
              },
              {
                "key": "width",
                "type": "float",
                "label": "宽度"
              },
              {
                "key": "angle",
                "type": "float",
                "label": "角度"
              }
            ]
          }
        }
      ]
    }
  ]
}
