{
  "name": "circinus-ad-astra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . && node --test scripts/shared/*.check.mjs scripts/architecture/*.check.mjs && node scripts/check-architecture.mjs && node scripts/check-identifier-length.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "release": "powershell -ExecutionPolicy Bypass -File ./build.ps1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "marked": "^18.0.4",
    "naive-ui": "^2.40.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.11"
  }
}
